# Copy to .env.local and adjust.
#
# Variables consumed by the browser must be prefixed NEXT_PUBLIC_. They are
# inlined at BUILD time, not read at runtime: changing one requires a rebuild.
#
# Read them only through src/shared/config/env.ts — never process.env directly.

# Backend API (suminia-backend)
NEXT_PUBLIC_API_URL=http://localhost:8001
